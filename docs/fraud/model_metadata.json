{
  "model_name": "FraudReviewClassifier",
  "framework": "PyTorch",
  "architecture": {
    "input_dim": 5000,
    "hidden_dim": 256,
    "dropout": 0.4,
    "layers": [
      "Linear(input_dim, 256) -> BatchNorm1d -> ReLU -> Dropout",
      "Linear(256, 128) -> BatchNorm1d -> ReLU -> Dropout",
      "Linear(128, 1)  # raw logit output"
    ]
  },
  "label_mapping": {
    "truthful": 0,
    "deceptive": 1
  },
  "inverse_label_mapping": {
    "0": "truthful",
    "1": "deceptive"
  },
  "prediction_threshold": 0.5,
  "vectorizer": {
    "type": "TfidfVectorizer",
    "ngram_range": [
      1,
      2
    ],
    "max_features": 5000,
    "min_df": 2,
    "sublinear_tf": true
  },
  "training_config": {
    "optimizer": "AdamW",
    "learning_rate": 0.001,
    "weight_decay": 0.0001,
    "loss_function": "BCEWithLogitsLoss",
    "batch_size": 32,
    "epochs_trained": 10,
    "early_stopping_patience": 7
  },
  "evaluation_metrics": {
    "accuracy": 0.8916666666666667,
    "precision": 0.8790322580645161,
    "recall": 0.9083333333333333,
    "f1_score": 0.8934426229508197,
    "roc_auc": 0.955486111111111
  },
  "preprocessing": {
    "text_cleaning": "lowercase, remove punctuation/special chars, collapse whitespace"
  },
  "dataset_source": "Deceptive Opinion Spam Corpus (Ott et al., Cornell University)",
  "pytorch_version": "2.11.0+cu128",
  "sklearn_input_type": "dense TF-IDF array (toarray())"
}